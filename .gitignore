# Virtual environment
.venv/
venv/

# macOS
.DS_Store

# Python cache
__pycache__/
*.pyc


# ==========================
# DATA
# ==========================

# Ignore raw datasets
data/raw/**/*.csv
data/raw/**/*.parquet
data/raw/**/*.XPT
data/raw/**/*.xpt
data/raw/**/*.zip

# Ignore intermediate/processed datasets
data/processed/*

# Keep only final train / validation / test CSV files
!data/processed/train_ready.csv
!data/processed/validation_ready.csv
!data/processed/test_ready.csv
# Tuning intermediates: regenerated by src/tuning.py, not deliverables.
# tuning_best_history.csv is a subset of tuning_histories.csv; the extra
# histories are per-epoch logs of the seed and pos_weight diagnostic runs.
results/models/tuning_checkpoints/
results/tuning_best_history.csv
results/tuning_extra_histories.csv

# Fitted evaluation pipelines are reproducible local artifacts (RF is large).
results/evaluation/models/
results/models/*_pipeline.joblib

# Separate local reproductions of the frozen evaluation.
results/evaluation_runs/

# IDEs and Editors
.idea/
.vscode/
*.swp